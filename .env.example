# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - FRONTEND (ALEM)
# No deploy da Vercel, defina estas três variáveis no painel (Project Settings > Environment Variables)
# ==============================================================

# URL do seu projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave pública anon do Supabase (Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL pública da API do Backend hospedada no Render (ou Railway)
# Pode ser informado com ou sem o sufixo /api (ex: https://alem-backend.onrender.com/api)
VITE_API_URL=https://your-backend-api.onrender.com/api
